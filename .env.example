SUPABASE_URL=

# Preferred: keep the Supabase server secret inside Supabase and let Vercel use the private Edge proxy.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROXY_KEY=

# Optional direct backend secret alternative.
SUPABASE_SECRET_KEY=
# Legacy fallback while migrating.
SUPABASE_SERVICE_ROLE_KEY=

AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
# Optional local fallback. On Vercel, VERCEL_OIDC_TOKEN is injected automatically for AI Gateway.
AI_GATEWAY_API_KEY=
LAB_MODEL=gpt-6.1-sol
LAB_FALLBACK_MODEL=gpt-5.6-sol
HEALTH_NAVIGATOR_MODEL=gpt-6.1-sol
HEALTH_NAVIGATOR_FALLBACK_MODEL=gpt-5.6-terra
SUPPORT_MODEL=gpt-6-luna
SUPPORT_FALLBACK_MODEL=gpt-5.6-luna
# Optional catalog-validated overrides; leave blank for automatic model discovery.
GATEWAY_LAB_MODEL=
GATEWAY_LAB_FALLBACK_MODEL=
GATEWAY_HEALTH_NAVIGATOR_MODEL=
GATEWAY_HEALTH_NAVIGATOR_FALLBACK_MODEL=
GATEWAY_SUPPORT_MODEL=
GATEWAY_SUPPORT_FALLBACK_MODEL=

ADMIN_PASSWORD=
SESSION_SECRET=
PUBLIC_SITE_URL=https://drman.vercel.app
PUBLIC_BASE_URL=https://drman.vercel.app

# DigiPay intentionally remains empty until merchant registration.
# Configure the UAT endpoint first and verify a real merchant transaction before production.
DIGIPAY_BASE_URL=
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
DIGIPAY_USERNAME=
DIGIPAY_PASSWORD=
DIGIPAY_VERIFY_TYPE=

NODE_ENV=production
