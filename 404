<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DrMan — صفحه پیدا نشد</title>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;700;900&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #050d1a;
  --accent: #00d4ff;
  --green: #00ff9d;
  --red: #ff4466;
  --text: #e8f4ff;
  --text-dim: #7aa0c4;
  --border: rgba(0,212,255,0.12);
}

* { margin:0; padding:0; box-sizing:border-box; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Vazirmatn', sans-serif;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* Grid background */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image: 
    linear-gradient(rgba(0,212,255,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,212,255,0.03) 1px, transparent 1px);
  background-size: 50px 50px;
  pointer-events: none;
  animation: gridMove 20s linear infinite;
}

@keyframes gridMove {
  0% { background-position: 0 0; }
  100% { background-position: 50px 50px; }
}

/* Glowing orbs */
.orb {
  position: fixed;
  border-radius: 50%;
  pointer-events: none;
  animation: float 8s ease-in-out infinite;
}

.orb1 {
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, rgba(255,68,102,0.08) 0%, transparent 70%);
  top: -100px;
  left: -100px;
}

.orb2 {
  width: 300px;
  height: 300px;
  background: radial-gradient(circle, rgba(0,212,255,0.08) 0%, transparent 70%);
  bottom: -100px;
  right: -100px;
  animation-delay: -4s;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(30px, 30px); }
}

/* Main content */
.content {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 40px 20px;
}

/* 404 big number */
.big-404 {
  position: relative;
  margin-bottom: 20px;
}

.num-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

.num {
  font-size: clamp(100px, 20vw, 180px);
  font-weight: 900;
  line-height: 1;
  background: linear-gradient(135deg, var(--accent), var(--green));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 0 30px rgba(0,212,255,0.4));
  animation: glitch 4s infinite;
}

.num-mid {
  font-size: clamp(60px, 12vw, 100px);
  animation: spin 3s linear infinite;
  filter: drop-shadow(0 0 20px rgba(255,68,102,0.5));
  display: inline-block;
}

@keyframes spin {
  0% { transform: rotateY(0deg); }
  50% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}

@keyframes glitch {
  0%, 90%, 100% { 
    text-shadow: none;
    transform: translate(0);
  }
  92% { 
    transform: translate(-3px, 1px);
    filter: drop-shadow(3px 0 rgba(255,68,102,0.8)) drop-shadow(-3px 0 rgba(0,212,255,0.8));
  }
  94% { 
    transform: translate(3px, -1px);
  }
  96% { 
    transform: translate(0);
  }
}

/* Scan line effect */
.scan-wrap {
  position: relative;
  overflow: hidden;
  display: inline-block;
}

.scan-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--accent), transparent);
  animation: scan 3s linear infinite;
  opacity: 0.5;
}

@keyframes scan {
  0% { top: 0; }
  100% { top: 100%; }
}

/* DNA helix animation */
.dna {
  display: flex;
  justify-content: center;
  gap: 4px;
  margin: 20px auto;
  height: 60px;
  align-items: center;
}

.dna-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  animation: dnaWave 1.5s ease-in-out infinite;
}

.dna-dot:nth-child(odd) { background: var(--accent); }
.dna-dot:nth-child(even) { background: var(--red); }

@keyframes dnaWave {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.5; }
  50% { transform: translateY(-20px) scale(1.3); opacity: 1; }
}

.dna-dot:nth-child(1) { animation-delay: 0s; }
.dna-dot:nth-child(2) { animation-delay: 0.1s; }
.dna-dot:nth-child(3) { animation-delay: 0.2s; }
.dna-dot:nth-child(4) { animation-delay: 0.3s; }
.dna-dot:nth-child(5) { animation-delay: 0.4s; }
.dna-dot:nth-child(6) { animation-delay: 0.5s; }
.dna-dot:nth-child(7) { animation-delay: 0.6s; }
.dna-dot:nth-child(8) { animation-delay: 0.7s; }
.dna-dot:nth-child(9) { animation-delay: 0.8s; }
.dna-dot:nth-child(10) { animation-delay: 0.9s; }

/* Text */
.title {
  font-size: clamp(20px, 4vw, 28px);
  font-weight: 700;
  margin-bottom: 12px;
  animation: fadeUp 0.6s ease 0.3s both;
}

.subtitle {
  font-size: 15px;
  color: var(--text-dim);
  max-width: 400px;
  margin: 0 auto 36px;
  line-height: 1.8;
  animation: fadeUp 0.6s ease 0.4s both;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Buttons */
.btn-wrap {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
  animation: fadeUp 0.6s ease 0.5s both;
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent), #0066ff);
  border: none;
  border-radius: 14px;
  padding: 14px 28px;
  color: white;
  font-family: 'Vazirmatn', sans-serif;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 8px 25px rgba(0,212,255,0.3);
}

.btn-primary:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 35px rgba(0,212,255,0.4);
}

.btn-secondary {
  background: rgba(0,212,255,0.08);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 14px 28px;
  color: var(--text-dim);
  font-family: 'Vazirmatn', sans-serif;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.btn-secondary:hover {
  border-color: var(--accent);
  color: var(--accent);
  transform: translateY(-3px);
}

/* Error code */
.error-code {
  margin-top: 40px;
  font-size: 11px;
  color: rgba(122,160,196,0.3);
  font-family: monospace;
  letter-spacing: 2px;
  animation: fadeUp 0.6s ease 0.6s both;
}

.error-code span {
  color: var(--red);
  opacity: 0.5;
}
</style>
</head>
<body>

<div class="orb orb1"></div>
<div class="orb orb2"></div>

<div class="content">

  <div class="big-404">
    <div class="scan-wrap">
      <div class="scan-line"></div>
      <div class="num-wrap">
        <div class="num">4</div>
        <div class="num-mid">🩺</div>
        <div class="num">4</div>
      </div>
    </div>
  </div>

  <div class="dna">
    <div class="dna-dot"></div>
    <div class="dna-dot"></div>
    <div class="dna-dot"></div>
    <div class="dna-dot"></div>
    <div class="dna-dot"></div>
    <div class="dna-dot"></div>
    <div class="dna-dot"></div>
    <div class="dna-dot"></div>
    <div class="dna-dot"></div>
    <div class="dna-dot"></div>
  </div>

  <div class="title">صفحه‌ای پیدا نشد!</div>
  <div class="subtitle">
    به نظر می‌رسه این صفحه وجود نداره یا به جای دیگه‌ای منتقل شده.<br>
    نگران نباش، سلامتت دست ماست! 💙
  </div>

  <div class="btn-wrap">
    <a href="/" class="btn-primary">🏠 بازگشت به خانه</a>
    <a href="/profile.html" class="btn-secondary">📋 پرونده سلامت</a>
  </div>

  <div class="error-code">
    ERROR_CODE: <span>404</span> · PAGE_NOT_FOUND · DRMAN_HEALTH_AI
  </div>

</div>

</body>
</html>
