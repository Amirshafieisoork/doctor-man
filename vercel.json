{
  "version": 2,
  "routes": [
    {
      "src": "/auth",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/auth.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/health",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/profile",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/profile.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/account",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/settings",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/settings.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/doctor-portal",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/visit-intake",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/admin",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/admin.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/payment-result",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/support",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/support.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Strict-Transport-Security": "max-age=31536000",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
      },
      "continue": true
    },
    {
      "src": "/index.html",
      "dest": "/home-v2.html"
    },
    {
      "src": "/support",
      "dest": "/support.html"
    },
    {
      "src": "/payment-result",
      "dest": "/payment-result.html"
    },
    {
      "src": "/robots.txt",
      "dest": "/api/router.js?route=robots"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/router.js?route=sitemap"
    },
    {
      "src": "/doctor/([^/]+)",
      "dest": "/api/router.js?route=doctor-page&slug=$1"
    },
    {
      "src": "/emergency/([^/]+)",
      "dest": "/api/router.js?route=emergency-page&token=$1"
    },
    {
      "src": "/learn/([^/]+)",
      "dest": "/api/router.js?route=learn-page&slug=$1"
    },
    {
      "src": "/learn",
      "dest": "/api/router.js?route=learn-page"
    },
    {
      "src": "/api/router(?:\\.js)?",
      "dest": "/api/router.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/router.js?route=$1"
    },
    {
      "src": "/",
      "dest": "/home-v2.html"
    },
    {
      "src": "/auth",
      "dest": "/auth-v2.html"
    },
    {
      "src": "/auth.html",
      "dest": "/auth-v2.html"
    },
    {
      "src": "/health",
      "dest": "/health-v4.html"
    },
    {
      "src": "/profile",
      "dest": "/health-v4.html"
    },
    {
      "src": "/profile.html",
      "dest": "/health-v4.html"
    },
    {
      "src": "/account",
      "dest": "/profile-v2.html"
    },
    {
      "src": "/settings",
      "dest": "/profile-v2.html"
    },
    {
      "src": "/settings.html",
      "dest": "/profile-v2.html"
    },
    {
      "src": "/doctors",
      "dest": "/doctors.html"
    },
    {
      "src": "/doctor-onboarding",
      "dest": "/doctor-onboarding.html"
    },
    {
      "src": "/doctor-portal",
      "dest": "/doctor-portal-v2.html"
    },
    {
      "src": "/visit-intake",
      "dest": "/visit-intake.html"
    },
    {
      "src": "/pricing",
      "dest": "/pricing-v2.html"
    },
    {
      "src": "/pricing.html",
      "dest": "/pricing-v2.html"
    },
    {
      "src": "/admin",
      "dest": "/admin-v7.html"
    },
    {
      "src": "/admin.html",
      "dest": "/admin-v7.html"
    },
    {
      "src": "/medical-methodology",
      "dest": "/medical-methodology.html"
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html"
    },
    {
      "src": "/terms",
      "dest": "/terms.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ],
  "builds": [
    {
      "src": "api/router.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "server/**",
        "maxDuration": 60
      }
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.webmanifest",
      "use": "@vercel/static"
    },
    {
      "src": "service-worker.js",
      "use": "@vercel/static"
    }
  ]
}
