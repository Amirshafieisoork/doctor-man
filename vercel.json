{
  "version": 2,
  "routes": [
    {
      "src": "/index.html",
      "dest": "/home-v2.html"
    },
    {
      "src": "/support",
      "dest": "/support.html"
    },
    {
      "src": "/payment-result",
      "dest": "/payment-result.html"
    },
    {
      "src": "/robots.txt",
      "dest": "/api/router?route=robots"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/router?route=sitemap"
    },
    {
      "src": "/doctor/([^/]+)",
      "dest": "/api/router?route=doctor-page&slug=$1"
    },
    {
      "src": "/emergency/([^/]+)",
      "dest": "/api/router?route=emergency-page&token=$1"
    },
    {
      "src": "/learn/([^/]+)",
      "dest": "/api/router?route=learn-page&slug=$1"
    },
    {
      "src": "/learn",
      "dest": "/api/router?route=learn-page"
    },
    {
      "src": "/api/router",
      "dest": "/api/router"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/router?route=$1"
    },
    {
      "src": "/",
      "dest": "/home-v2.html"
    },
    {
      "src": "/auth",
      "dest": "/auth-v2.html"
    },
    {
      "src": "/auth.html",
      "dest": "/auth-v2.html"
    },
    {
      "src": "/health",
      "dest": "/health-v4.html"
    },
    {
      "src": "/profile",
      "dest": "/health-v4.html"
    },
    {
      "src": "/profile.html",
      "dest": "/health-v4.html"
    },
    {
      "src": "/account",
      "dest": "/profile-v2.html"
    },
    {
      "src": "/settings",
      "dest": "/profile-v2.html"
    },
    {
      "src": "/settings.html",
      "dest": "/profile-v2.html"
    },
    {
      "src": "/doctors",
      "dest": "/doctors.html"
    },
    {
      "src": "/doctor-onboarding",
      "dest": "/doctor-onboarding.html"
    },
    {
      "src": "/doctor-portal",
      "dest": "/doctor-portal-v2.html"
    },
    {
      "src": "/visit-intake",
      "dest": "/visit-intake.html"
    },
    {
      "src": "/pricing",
      "dest": "/pricing-v2.html"
    },
    {
      "src": "/pricing.html",
      "dest": "/pricing-v2.html"
    },
    {
      "src": "/admin",
      "dest": "/admin-v7.html"
    },
    {
      "src": "/admin.html",
      "dest": "/admin-v7.html"
    },
    {
      "src": "/medical-methodology",
      "dest": "/medical-methodology.html"
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html"
    },
    {
      "src": "/terms",
      "dest": "/terms.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ],
  "functions": {
    "api/router.js": {
      "maxDuration": 45
    }
  },
  "headers": [
    {
      "source": "/auth",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/auth.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/health",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/profile",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/profile.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/account",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/settings",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/settings.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/doctor-portal",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/visit-intake",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/payment-result",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/support",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/support.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
